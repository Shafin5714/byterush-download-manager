{
  "name": "byterush-desktop",
  "productName": "ByteRush",
  "version": "0.1.0",
  "description": "Fast segmented download manager with YouTube support",
  "main": "out/main/main.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:node": "tsc -p tsconfig.node.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:engine": "powershell -ExecutionPolicy Bypass -File scripts/build-engine.ps1",
    "build": "npm run build:engine && npm run build:renderer && npm run build:node",
    "start": "electron .",
    "smoke": "npm run build && set BYTERUSH_SMOKE=1&& electron .",
    "dist": "npm run build && electron-builder --win",
    "package:extension": "powershell -ExecutionPolicy Bypass -File ../../scripts/package-extension.ps1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.2",
    "vite": "^5.4.6"
  }
}
