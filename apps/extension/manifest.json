{
  "manifest_version": 3,
  "name": "ByteRush Bridge",
  "version": "0.1.0",
  "description": "Sends browser downloads to the ByteRush download manager running on 127.0.0.1:29641.",
  "permissions": ["downloads", "storage"],
  "host_permissions": ["http://127.0.0.1:29641/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ByteRush Bridge",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
